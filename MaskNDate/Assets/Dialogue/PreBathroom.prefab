  m_Script: {fileID: 11500000, guid: 4c81d4b4efd64fa4ba77a284cf4062c0, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::Dialogue
  speachNumber: 0
  speach:
  - He leaves before you can respond.
  - Now standing alone in this room, you begin to overthink.
  - The though of walking up to a pre-established group and weaseling your way in
    makes you sick.
  - The idea of continung to stand here until the vampire is finished talking with
    his friends makes you sicker.
  - You decide to make your way to the bathroom,
  - to hide out for a bit, maybe courage will come to you if you let yourself relax
    for a moment.
  who: 010000000100000001000000010000000100000001000000
